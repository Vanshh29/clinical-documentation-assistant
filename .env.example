# Copy to .env — never commit .env. Synthetic data only.

# --- Database ---
POSTGRES_USER=cda
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=cda
DATABASE_URL=postgresql+asyncpg://cda:change-me-local-only@localhost:5432/cda

# --- Kafka (Redpanda locally) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_NOTE_SUBMITTED=note.submitted
KAFKA_TOPIC_SUMMARY_READY=summary.ready

# --- Auth (mock OIDC-style issuer inside the API; see docs/adr/ADR-002) ---
AUTH_JWT_SECRET=dev-only-change-me-at-least-32-characters
AUTH_JWT_ISSUER=http://localhost:8000
AUTH_JWT_AUDIENCE=cda-web
AUTH_ACCESS_TOKEN_TTL_MINUTES=30

# --- PII placeholder-map encryption (Fernet key) ---
PII_ENCRYPTION_KEY=          # `make env` generates this

# --- LLM ---
# fake = offline deterministic extractor (default, no key needed). openrouter = real model.
LLM_PROVIDER=fake
OPENROUTER_API_KEY=          # only needed when LLM_PROVIDER=openrouter
LLM_MODEL=                   # OpenRouter model slug, e.g. vendor/model-name
LLM_TIMEOUT_SECONDS=60
LLM_MAX_INPUT_TOKENS=8000
LLM_MAX_RETRIES=3            # transport retries (429/5xx/timeouts) inside the provider
LLM_MAX_VALIDATION_RETRIES=2 # re-asks with the validation error fed back
LLM_PRICE_IN_PER_MTOK=0      # USD per million tokens, used if the API reports no cost
LLM_PRICE_OUT_PER_MTOK=0
PROMPT_VERSION=v3

# --- Observability ---
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Data retention ---
RETENTION_DAYS=30
